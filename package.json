{
  "name": "codelens-local",
  "version": "1.0.4",
  "description": "codelens-local — App desktop (Windows, Mac, Linux)",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "desktop": "electron .",
    "exe": "electron-builder --win portable --publish never",
    "start": "electron .",
    "build": "electron-builder --publish=never",
    "build:win": "electron-builder --win --x64 --publish=never",
    "build:mac": "electron-builder --mac --x64 --arm64 --publish=never",
    "build:linux": "electron-builder --linux --x64 --publish=never"
  },
  "build": {
    "appId": "com.meuapp.codelenslocal",
    "productName": "codelens-local",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "www/**/*",
      "!www/package.json",
      "!www/**/package.json",
      "!www/**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "sign": null
    },
    "copyright": "© 2026 codelens-local",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "codelens-local"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false
    },
    "dmg": {
      "background": null
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "description": "codelens-local — App desktop"
    },
    "compression": "normal",
    "removePackageScripts": true,
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false
  },
  "devDependencies": {
    "electron": "^33.4.0",
    "electron-builder": "^25.1.8",
    "@capacitor/cli": "^7.0.0"
  },
  "dependencies": {
    "@capacitor/core": "^7.0.0",
    "@capacitor/android": "^7.0.0"
  },
  "author": "codelens-local"
}
